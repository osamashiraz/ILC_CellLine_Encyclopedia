# 1. Point R to the standard macOS location for Google Chrome
Sys.setenv(CHROMOTE_CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
# 2. Configure chromote with the necessary arguments to prevent timeouts
set_default_chromote_object(
Chromote$new(
browser = Chrome$new(
args = c("--no-sandbox", "--disable-dev-shm-usage", "--disable-gpu")
)
